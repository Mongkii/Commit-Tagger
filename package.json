{
  "name": "commit-tagger",
  "displayName": "Commit Tagger",
  "description": "Generate tag for your commit at ease.",
  "version": "2.3.0",
  "publisher": "Mongkii",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "tag",
    "commitizen"
  ],
  "license": "SEE LICENSE IN LICENSE.txt",
  "bugs": {
    "url": "https://github.com/mongkii/commit-tagger/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mongkii/commit-tagger"
  },
  "homepage": "https://github.com/mongkii/commit-tagger/blob/master/README.md",
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.commitTagger",
        "title": "Commit Tagger",
        "icon": {
          "dark": "resources/dark/tag.svg",
          "light": "resources/light/tag.svg"
        }
      },
      {
        "command": "extension.commitTagger.settings",
        "title": "Commit Tagger Settings"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "when": "scmProvider == git",
          "command": "extension.commitTagger",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.commitTagger",
        "key": "shift+alt+c",
        "mac": "cmd+ctrl+c"
      }
    ]
  },
  "scripts": {
    "clean": "rm -rf out",
    "compile:webview": "bun run check-types:webview && bun run check-types:tools && vite build",
    "compile:main": "tsc -p ./tsconfig.json",
    "compile": "bun run clean && bun run compile:webview && bun run compile:main",
    "watch:webview": "vite build --watch",
    "watch:main": "tsc -w -p ./tsconfig.json",
    "watch:types:webview": "tsc --watch -p src/webview/tsconfig.json",
    "watch": "bun run clean && concurrently --kill-others \"bun run watch:webview\" \"bun run watch:main\" \"bun run watch:types:webview\"",
    "check-types:main": "tsc --noEmit -p tsconfig.json",
    "check-types:webview": "tsc -p src/webview/tsconfig.json",
    "check-types:tools": "tsc -p tsconfig.tools.json",
    "check-types": "bun run check-types:main && bun run check-types:webview && bun run check-types:tools",
    "lint": "eslint src",
    "vscode:prepublish": "bun run compile",
    "pack": "bunx @vscode/vsce package",
    "scaffold": "bunx yo code"
  },
  "devDependencies": {
    "@preact/preset-vite": "latest",
    "@types/node": "latest",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vscode/vsce": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "generator-code": "latest",
    "preact": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.59.0",
    "vite": "latest",
    "yo": "latest"
  }
}
